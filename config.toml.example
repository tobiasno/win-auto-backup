# Auto-Backup Configuration File
# Copy this file to %APPDATA%\Roaming\auto-backup\config.toml and edit the values

# Source folders to backup - you can specify multiple folders
# For a single folder backup (files will be at the root of the zip):
# source_folders = ["C:\\Users\\YourUsername\\Documents"]

# For multiple folders (each will be in a separate folder in the zip):
source_folders = [
    "C:\\Users\\YourUsername\\Documents",
    "C:\\Users\\YourUsername\\Pictures"
]

# Backward compatibility: you can still use source_folder for a single folder
# Note: If both source_folder and source_folders are set, source_folders takes precedence
# source_folder = "C:\\Users\\YourUsername\\Documents"

# Destination folder (where backups will be saved, e.g., OneDrive folder)
destination_path = "C:\\Users\\YourUsername\\OneDrive"

# Base name for backup files (will be appended with timestamp)
base_name = "Backup"

# Maximum number of backups to keep (older backups will be deleted)
max_backups = 30

# Compression level (0-9, where 0 is no compression and 9 is maximum)
# Optional: defaults to 5 if not specified
compression_level = 5
