# Auto-Backup Configuration File
# Copy this file to %APPDATA%\auto-backup\config.toml and edit the values

# Source folder to backup (the folder you want to backup)
source_folder = "C:\\Users\\e00873\\Tobi"

# Destination folder (where backups will be saved, e.g., OneDrive folder)
destination_path = "C:\\Users\\e00873\\OneDrive - SPIE"

# Base name for backup files (will be appended with timestamp)
base_name = "Tobi_Backup"

# Maximum number of backups to keep (older backups will be deleted)
max_backups = 30

# Compression level (0-9, where 0 is no compression and 9 is maximum)
# Optional: defaults to 5 if not specified
compression_level = 5
